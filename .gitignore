# ---- local data / resources: never commit -------------------------------------------------
/resources/
/old_resources/
/atlas_data/
/raw_data/
/data/
/outputs/
/work/
/notebooks/
/scratch/
*.ipynb
*.sif
*.pt
*.gbz
*.cf
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.gam

# ---- ingest run artefacts ----------------------------------------------------------------
.snakemake/
checkpoints/
benchmarks/
*_results/
config.yaml
!ecoli_ingest/src/ecoli_ingest/config/config.template.yaml
*.log

# ---- examples: one folder per example, kept in git as README.md, run.sh (+ config.yaml, samples.csv) -----
# Everything a run writes inside examples/<name>/ (downloads in sra/, results, figures, logs) stays untracked.
/examples/*/*
!/examples/*/config.yaml
!/examples/*/README.md
!/examples/*/samples.csv
!/examples/*/run.sh

# ---- python --------------------------------------------------------------------------------
__pycache__/
*.pyc
*.egg-info/
/ecoli_ingest/build/lib/
/ecoli_ingest/dist/
/ecoli_atlas/build/
/ecoli_atlas/dist/
.pytest_cache/
.venv/

