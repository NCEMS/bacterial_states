{
 "gse": "GSE112430",
 "notes": "30 clinical non-O157 STEC isolates (stx2a, eae positive), each non-induced (control) or mitomycin C 0.25 ug/ml for 1.5 h (dna_damage, short). 'Induced' means mitomycin C, so inducer_added false. Phase mid_exponential from the design ('at exponential growth'), kept for the 1.5 h samples. SILAC medium -> base_medium other, defined_rich. WT re-read: clinical STEC isolates used as isolated, no modification described.",
 "default": {
  "growth_phase": {
   "v": "mid_exponential",
   "b": "stated",
   "q": "induced with mitomycin c or non-induced, at exponential growth in SILAC medium."
  },
  "base_medium": {
   "v": "other",
   "b": "stated",
   "q": "fresh SILAC (stable isotope labeling with amino acids in cell culture) medium optimized for non-auxotrophic E. coli"
  },
  "medium_class": {
   "v": "defined_rich",
   "b": "inferred",
   "q": "fresh SILAC (stable isotope labeling with amino acids in cell culture) medium optimized for non-auxotrophic E. coli"
  },
  "amino_acids_supplied": {
   "v": true,
   "b": "inferred",
   "q": "fresh SILAC (stable isotope labeling with amino acids in cell culture) medium optimized for non-auxotrophic E. coli"
  },
  "growth_temperature": {
   "v": 37,
   "b": "stated",
   "q": "before incubation at 37 °C with agitation until reaching an OD600 of approximately 0.3."
  },
  "culture_mode": {
   "v": "batch_shaken",
   "b": "inferred",
   "q": "before incubation at 37 °C with agitation until reaching an OD600 of approximately 0.3."
  },
  "oxygen": {
   "v": "aerobic",
   "b": "inferred",
   "q": "before incubation at 37 °C with agitation until reaching an OD600 of approximately 0.3."
  },
  "genotype_class": {
   "v": "wild_type",
   "b": "inferred",
   "q": "stx2a and eae positive STEC strains of non-O157 serogroups isolated from children"
  },
  "global_regulator_perturbed": {
   "v": false,
   "b": "study_default",
   "q": "Comparison of 30 non-O157 STEC strains"
  },
  "strain_group": {
   "v": "EHEC_STEC",
   "b": "stated",
   "q": "30 stx2a and eae positive STEC strains of non-O157 serogroups"
  },
  "assay_class": {
   "v": "total_rnaseq",
   "b": "stated",
   "q": "Library preparation was performed with TruSeq Stranded Total RNA HT Sample Prep Kit (Illumina)."
  },
  "rrna_removal": {
   "v": "depletion",
   "b": "stated",
   "q": "Ribosomal RNA was removed using Ribo-Zero rRNA Removal Kit for Gram-Negative Bacteria (Epicentre)."
  },
  "mixed_organism": {
   "v": false,
   "b": "study_default",
   "q": "induced with mitomycin c or non-induced, at exponential growth in SILAC medium."
  },
  "inducer_added": {
   "v": false,
   "b": "study_default",
   "q": "induced with mitomycin c or non-induced, at exponential growth in SILAC medium."
  },
  "transcription_arrested": {
   "v": false,
   "b": "study_default",
   "q": "induced with mitomycin c or non-induced, at exponential growth in SILAC medium."
  }
 },
