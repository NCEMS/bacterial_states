 "rules": [
  {
   "field": "ch:strain",
   "regex": "^BW25113$",
   "set": {
    "genotype_class": {
     "v": "wild_type",
     "b": "stated",
     "q": ""
    },
    "global_regulator_perturbed": {
     "v": false,
     "b": "stated",
     "q": ""
    }
   }
  },
  {
   "field": "ch:strain",
   "regex": "^\\[delta\\]fum",
   "set": {
    "genotype_class": {
     "v": "deletion",
     "b": "stated",
     "q": ""
    },
    "global_regulator_perturbed": {
     "v": false,
     "b": "stated",
     "q": ""
    }
   }
  },
  {
   "field": "ch:strain",
   "regex": "^\\[delta\\]fumA$",
   "set": {
    "perturbed_genes": {
     "v": "fumA",
     "b": "stated",
     "q": ""
    }
   }
  },
  {
   "field": "ch:strain",
   "regex": "^\\[delta\\]fumB$",
   "set": {
    "perturbed_genes": {
     "v": "fumB",
     "b": "stated",
     "q": ""
    }
   }
  },
  {
   "field": "ch:strain",
   "regex": "^\\[delta\\]fumAB$",
   "set": {
    "perturbed_genes": {
     "v": "fumA;fumB",
     "b": "stated",
     "q": ""
    }
   }
  },
  {
   "field": "ch:strain",
   "regex": "^\\[delta\\]fumACB$",
   "set": {
    "perturbed_genes": {
     "v": "fumA;fumC;fumB",
     "b": "stated",
     "q": ""
    }
   }
  },
  {
   "field": "ch:treatment",
   "regex": "^untreated$",
   "set": {
    "treatment": {
     "v": "none",
     "b": "stated",
     "q": ""
    }
   }
  },
  {
   "field": "ch:treatment",
   "regex": "methylmethansulfonate",
   "set": {
    "treatment": {
     "v": "dna_damage",
     "b": "stated",
     "q": ""
    },
    "exposure": {
     "v": "acute",
     "b": "stated",
     "q": "0.35% [v/v] MMS, 30 min, 37*C, 200rpm"
    }
   }
  },
  {
   "field": "source_name",
   "regex": "^BW25113 \\(WT\\)-\\d$",
   "set": {
    "is_control": {
     "v": true,
     "b": "stated",
     "q": ""
    }
   }
  }
 ],
