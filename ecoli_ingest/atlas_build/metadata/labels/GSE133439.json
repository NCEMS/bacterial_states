{
 "gse": "GSE133439",
 "notes": "Strain 685/686 are lab numbers; strain group K-12 from the organism field. 90-min ciprofloxacin samples keep the pre-treatment mid-log phase (<= 2 h rule).",
 "default": {
  "base_medium": {
   "v": "LB",
   "b": "study_default",
   "q": "diluted 100-fold into fresh LB medium"
  },
  "medium_class": {
   "v": "complex",
   "b": "inferred",
   "q": "diluted 100-fold into fresh LB medium"
  },
  "amino_acids_supplied": {
   "v": true,
   "b": "inferred",
   "q": "diluted 100-fold into fresh LB medium"
  },
  "culture_mode": {
   "v": "batch_shaken",
   "b": "study_default",
   "q": "at 37 °C with shaking"
  },
  "oxygen": {
   "v": "aerobic",
   "b": "inferred",
   "q": "at 37 °C with shaking"
  },
  "growth_temperature": {
   "v": 37,
   "b": "study_default",
   "q": "at 37 °C with shaking"
  },
  "growth_phase": {
   "v": "mid_exponential",
   "b": "stated",
   "q": "grown to mid-log phase (OD600 = 0.3)"
  },
  "inducer_added": {
   "v": false,
   "b": "study_default",
   "q": "treated with ciprofloxacin (5 MIC) for 0 min and 90 min"
  },
  "transcription_arrested": {
   "v": false,
   "b": "study_default",
   "q": "treated with ciprofloxacin (5 MIC) for 0 min and 90 min"
  },
  "mixed_organism": {
   "v": false,
   "b": "study_default",
   "q": "treated with ciprofloxacin (5 MIC) for 0 min and 90 min"
  },
  "strain_group": {
   "v": "K-12",
   "b": "stated",
   "q": "Mid-log-phase cultures of E. coli K-12"
  },
  "assay_class": {
   "v": "total_rnaseq",
   "b": "study_default",
   "q": "rRNAs were removed by the Ribo-zero kit to enrich mRNAs"
  },
  "rrna_removal": {
   "v": "depletion",
   "b": "study_default",
   "q": "rRNAs were removed by the Ribo-zero kit to enrich mRNAs"
  },
  "is_control": {
   "v": false,
   "b": "study_default",
   "q": "compare the transcriptional profiles of the wild-type and the ΔptsI mutant strains before and after ciprofloxacin treatment"
  }
 },
 "rules": [
  {
   "field": "title",
   "regex": "^WT",
   "set": {
    "genotype_class": {
     "v": "wild_type",
     "b": "stated",
     "q": ""
    },
    "global_regulator_perturbed": {
     "v": false,
     "b": "inferred",
     "q": ""
    }
   }
  },
  {
   "field": "title",
   "regex": "^ptsI",
   "set": {
    "genotype_class": {
     "v": "deletion",
     "b": "stated",
     "q": ""
    },
    "perturbed_genes": {
     "v": "ptsI",
     "b": "stated",
     "q": ""
    },
    "global_regulator_perturbed": {
     "v": false,
     "b": "inferred",
     "q": ""
    }
   }
  },
  {
   "field": "ch:treatment",
   "regex": "^No treatment",
   "set": {
    "treatment": {
     "v": "none",
     "b": "stated",
     "q": ""
    }
   }
  },
  {
   "field": "ch:treatment",
   "regex": "ciprofloxacin for 90 min",
   "set": {
    "treatment": {
     "v": "abx_dna_gyrase",
     "b": "stated",
     "q": ""
    },
    "exposure": {
     "v": "short",
     "b": "stated",
     "q": ""
    }
   }
  },
  {
   "field": "title",
   "regex": "^WT 0 min",
   "set": {
    "is_control": {
     "v": true,
     "b": "stated",
     "q": "The cultures immediately before ciprofloxacin treatment were used as a control (time 0)."
    }
   }
  }
 ],
 "samples": {}
}
