 "rules": [
  {
   "field": "source_name",
   "regex": "OD 600 between 0\\.(2-0\\.3|4-0\\.5)",
   "set": {
    "growth_phase": {
     "v": "mid_exponential",
     "b": "inferred",
     "q": ""
    }
   }
  },
  {
   "field": "ch:treatment",
   "regex": "pH 7\\.0",
   "set": {
    "treatment": {
     "v": "none",
     "b": "stated",
     "q": ""
    }
   }
  },
  {
   "field": "ch:treatment",
   "regex": "pH 5\\.0",
   "set": {
    "treatment": {
     "v": "acid",
     "b": "stated",
     "q": ""
    },
    "exposure": {
     "v": "adapted",
     "b": "inferred",
     "q": "Overnight culture grown in LB was diluted 1:100 in fresh LB of pH 7.0 or pH 5.0"
    }
   }
  },
  {
   "field": "ch:genotype",
   "regex": "^wild-type$",
   "set": {
    "genotype_class": {
