{
 "gse": "GSE73672",
 "notes": "25 single-gene knockouts of BW25113 vs wild type in two batches. Batch 1 (LB or M9 + 0.3% glucose, 12 h from a small inoculum) -> stationary inferred (>=12 h batch). Batch 2: protocol says harvested at late stationary phase but descriptions say grown for 8 h -> conflicting phase evidence, growth_phase left out; batch 2 temperature not stated. Glucose in LB counted as supplement; carbon_source left out for LB. Shaking/aeration not described. Wild type in each medium/batch is a control. WT re-read: parental BW25113 is wild_type.",
 "default": {
  "genotype_class": {
   "v": "deletion",
   "b": "stated",
   "q": "Genome-wide expression profiling of 25 single-gene knockouts for BW25113"
  },
  "global_regulator_perturbed": {
   "v": false,
   "b": "inferred",
   "q": "Genome-wide expression profiling of 25 single-gene knockouts for BW25113"
  },
  "is_control": {
   "v": false,
   "b": "study_default",
   "q": "Genome-wide expression profiling of 25 single-gene knockouts for BW25113 and its wild-type"
  },
  "treatment": {
   "v": "none",
   "b": "study_default",
   "q": "Genome-wide expression profiling of 25 single-gene knockouts for BW25113 and its wild-type grown with either LB or M9 media supplemented with glucose"
  },
  "inducer_added": {
   "v": false,
   "b": "study_default",
   "q": "Genome-wide expression profiling of 25 single-gene knockouts for BW25113 and its wild-type grown with either LB or M9 media supplemented with glucose"
  },
  "transcription_arrested": {
   "v": false,
   "b": "study_default",
   "q": "Genome-wide expression profiling of 25 single-gene knockouts for BW25113 and its wild-type grown with either LB or M9 media supplemented with glucose"
  },
  "mixed_organism": {
   "v": false,
   "b": "study_default",
   "q": "Genome-wide expression profiling of 25 single-gene knockouts for BW25113 and its wild-type"
  },
  "strain_group": {
   "v": "K-12",
   "b": "stated",
   "q": "BW25113"
  },
  "strain_name": {
   "v": "BW25113",
   "b": "stated",
   "q": "BW25113"
  },
  "assay_class": {
   "v": "total_rnaseq",
   "b": "stated",
   "q": "Total RNA was extracted from frozen cultures using RNeasy kit"
  }
 },
