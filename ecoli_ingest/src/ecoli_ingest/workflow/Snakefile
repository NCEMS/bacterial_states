        mkdir -p {results_dir}/{wildcards.sample}/feature_overlap
        bash {scripts_dir}/gene_type.sh {annotation_bed} {input.bam} {output.feature_overlap} {scripts_dir} {params.call} {params.layout}
        """

#Summarizing all outputs with MultiQC
rule multiqc:
    input:
        all_qc_inputs=lambda wc: [
            f"{results_dir}/{s}/fastp/{s}_fastp.json"
            for s in SAMPLES.keys()
        ] + ([
            f"{results_dir}/{s}/centrifuge/{s}_report.txt"
            for s in SAMPLES.keys()
        ] if centrifuge_enabled else []),
        gated_inputs=lambda wc: [
            f"{results_dir}/{s}/fastqc/{s}_clean_R1_fastqc.zip"
            for s in get_passed_samples_from_checkpoint(wc)
        ] + ([
            f"{results_dir}/{s}/fastqc/{s}_clean_R2_fastqc.zip"
            for s in get_passed_samples_from_checkpoint(wc)
        ] if not SE else []) + [
            f"{results_dir}/{s}/vg/{s}_giraffe.stats.txt"
            for s in get_passed_samples_from_checkpoint(wc)
        ] + [
            f"{results_dir}/{s}/rseqc/{s}_infer_experiment.txt"
            for s in get_passed_samples_from_checkpoint(wc)
        ] + [
            f"{results_dir}/{s}/feature_overlap/{s}_feature_overlap_mqc.tsv"
            for s in get_passed_samples_from_checkpoint(wc)
        ] + [
            f"{results_dir}/all_samples_raw_counts.txt.summary",
            f"{results_dir}/strandedness_mqc.tsv"
        ],
        # MultiQC picks this up as custom content; declare it so MultiQC waits for DESeq2 to finish writing it
        pca_mqc=f"{results_dir}/deseq2/pca_mqc.tsv"
    output:
        html=f"{results_dir}/multiqc_report.html"
    params:
        results_dir=f"{results_dir}/",
        # with Centrifuge off, keep reports left over from an earlier run out of the report
        # (MultiQC matches --ignore against file/directory names, not whole paths)
        ignore="" if centrifuge_enabled else "--ignore centrifuge"
    shell:
        """
        multiqc {params.results_dir} -o {params.results_dir} -c {scripts_dir}/multiqc_config.yaml {params.ignore} \
            --cl-config "custom_logo: '{scripts_dir}/logo.png'" --filename multiqc_report.html --force
        """
