        python {scripts_dir}/annotate_counts.py --counts {input.counts} --gff {input.gff} \
            --extended {output.extended} --counts-out {output.clean}
        """

#Custom addition to multiqc, have to keep mqc name or it will not be parsed
rule feature_overlap:
    input:
        bam = f"{results_dir}/{{sample}}/vg/{{sample}}_sort.bam",
        strand = f"{results_dir}/{{sample}}/rseqc/{{sample}}_strandedness.tsv"
    output:
