#Snakefile for NCEMS inGEST RNA-seq pipeline designed by Alexis Morrissey (contact on github)

###Getting config information

import glob, json, os, sys

configfile: "config.yaml"
experiment_name = config.get("experiment", "experiment_unknown")
# Results directory inside the run directory: <experiment>_results unless `results_dir` is set.
results_dir = (config.get("results_dir") or f"{experiment_name}_results").rstrip("/")

# Resource files default to the standard layout under `resources_dir` (the ecoli_ingest launcher
# passes --config resources_dir=...). An explicit per-file entry in config.yaml still wins.
# Keep these relative paths in sync with ecoli_ingest/paths.py (RESOURCE_FILES).
resources_dir = config.get("resources_dir", "../resources")
def _resource(key, relpath):
    return config.get(key) or os.path.join(resources_dir, relpath)

annotation_gff = _resource("annotation_gff", "annotation/GCF_000005845.2_ASM584v2_genomic_siRNA.gff")
annotation_source_gff = _resource("annotation_source_gff", "annotation/GCF_000005845.2_ASM584v2_genomic.gff")
annotation_bed = _resource("annotation_bed", "annotation/GCF_000005845.2_ASM584v2_genomic.bed")
vg_index = _resource("vg_index", "vg/ecoli_graph_test")
centrifuge_index_path = _resource("centrifuge_index_path", "centrifuge/p_compressed+h+v")
gref = config.get("ref", "GCF_000005845_2_ASM584v2_genomic#0#NC_000913.3")
linear_index = config.get("linear", None)
# Workflow scripts live next to this Snakefile; override only for development.
scripts_dir = config.get("scripts_dir") or os.path.join(workflow.basedir, "scripts")

#Getting read length for vg minimizer
def get_minimizer_for_sample(sample_name):
    fastq_path = None
    cleaned_path = f"{results_dir}/{sample_name}/{sample_name}_clean_R1.fastq"
    
    if os.path.exists(cleaned_path):
        fastq_path = cleaned_path
    
    if fastq_path is None or not os.path.exists(fastq_path):
        print(f"Warning: Could not find fastq for {sample_name}, using default minimizer", flush=True)
        return vg_index + ".d2.min"
    
    total_length = 0
    read_count = 0
    max_reads = 1000
    
    try:
        opener = open
        mode = 'r'
        with opener(fastq_path, mode) as f:
            for i, line in enumerate(f):
                if i % 4 == 1:
                    total_length += len(line.strip())
                    read_count += 1
                    if read_count >= max_reads:
                        break
        
        if read_count > 0:
            avg_length = total_length / read_count
            print(f"Sample {sample_name}: Average read length = {avg_length:.1f}bp", flush=True)
            
            if avg_length < 50:
                print(f"Using shortest read minimizer (k=15)", flush=True)
                return vg_index + ".d2.k15.min"
            else:
                print(f"Using standard minimizer (k=29)", flush=True)
                return vg_index + ".d2.min"
    except Exception as e:
        return vg_index + ".d2.min"


#Where each sample's reads come from (scripts/sra_reads.py is shared with `ecoli_ingest check`).
# A sample gives r1/r2 (a file or a list of files per mate, concatenated before fastp) or an
# `accession` (SRR/SRX/SRS/GSM) whose reads are fetched into `sra_dir`: with sra-tools (prefetch +
# fasterq-dump) first and the ENA FASTQ files as the backup (`sra_method: auto`, the default), or
# from one source only (`sra_method: sra-tools` / `ena`). Resolving an accession needs the network
# once; the answer is cached under <sra_dir>/manifest/<ACC>.json.
sys.path.insert(0, scripts_dir)
import sra_reads

SAMPLES = config.get("samples", {})
SRA_DIR = config.get("sra_dir", "sra")
READS = sra_reads.resolve_samples(SAMPLES, SRA_DIR, os.path.join(SRA_DIR, "manifest"), log=sys.stderr)
RUN_FILES = {run: files for spec in READS.values() for run, files in spec["runs"].items()}
RUN_SPOTS = {run: n for spec in READS.values() for run, n in spec.get("spots", {}).items()}
SRA_METHOD = sra_reads.check_method(config.get("sra_method", "auto"))

# Concurrent downloads are capped by the `download_slots` resource: `--resources download_slots=N`
# (the launcher's --max-downloads) wins, else config `max_downloads`, else 4.
if "download_slots" not in workflow.global_resources:
    workflow.register_resource("download_slots", int(config.get("max_downloads", 4)))

#Getting SE or PE
num_se = sum(spec["r2"] is None for spec in READS.values())
num_pe = len(READS) - num_se
SE = num_se > 0

# Runs to fetch, by the mates the workflow reads: both, or mate 1 only (single-end runs, and
# paired runs when the whole run is treated as single-end).
SRA_RUNS_PE = sorted(RUN_FILES) if not SE else []
SRA_RUNS_SE = sorted(RUN_FILES) if SE else []

def sra_fetch_params(run, mates):
    """Arguments of `sra_reads.py fetch` for one run."""
    ena = {m: RUN_FILES[run][m] for m in mates if m in RUN_FILES[run]}
    return {"ena": json.dumps(ena, separators=(",", ":")), "spots": RUN_SPOTS.get(run) or 0}
if num_se > 0 and num_pe > 0:
    print("WARNING: Mixed SE and PE samples detected. Defaulting to SE mode for all.", flush=True)

def raw_reads(sample, mate):
    """The file fastp reads for one mate: the configured/downloaded file itself when there is
    exactly one, otherwise the concatenation made by merge_reads."""
    files = READS[sample]["r1" if mate == 1 else "r2"]
    if len(files) == 1:
        return files[0]
    ext = "fastq.gz" if sra_reads.is_gz(files[0]) else "fastq"
    return f"{results_dir}/{sample}/raw/{sample}_R{mate}.{ext}"

wildcard_constraints:
    sample="[^/]+",
    run="[SED]RR[0-9]+",
    mate="[12]",
    ext="fastq(\\.gz)?"


#Getting contrasts
deseq2_contrasts = config.get("deseq2", {}).get("contrasts", [])
contrast_names = [f"{ref}_vs_{test}" for factor, ref, test in deseq2_contrasts]


#QC checkpoint on/off
fastp_qc_is_configured = config.get("fastp_min_kept_percentage") is not None
# Centrifuge (contamination screen) runs unless `centrifuge: false`; its gate needs a threshold too
centrifuge_enabled = bool(config.get("centrifuge", True))
centrifuge_qc_is_configured = centrifuge_enabled and config.get("centrifuge_min_percentage") is not None
# Paired-end adapter detection in fastp is off unless `fastp_detect_adapter_for_pe: true`. Off gives
# plain `fastp` defaults (overlap-based adapter removal only), which is how the reads behind the
# atlas training counts (merged_count_table.txt) were processed.
fastp_pe_extra = "--detect_adapter_for_pe" if bool(config.get("fastp_detect_adapter_for_pe", False)) else ""


###Checkpoint function for QC metrics collected above (fastp and centrifuge)
checkpoint qc_passed_samples:
    input:
        fastp_json=lambda wc: [
            f"{results_dir}/{s}/fastp/{s}_fastp.json" for s in SAMPLES.keys()
        ] if fastp_qc_is_configured else [],
        centrifuge_report=lambda wc: [
            f"{results_dir}/{s}/centrifuge/{s}_report.txt" for s in SAMPLES.keys()
        ] if centrifuge_qc_is_configured else []
    output:
        directory("checkpoints/passed/"),
        "checkpoints/qc_failures.json"
    run:
        import os, json
        os.makedirs("checkpoints/passed", exist_ok=True)
        failures = {}
        passed_samples = set(SAMPLES.keys())

        #Fastp
        if fastp_qc_is_configured:
            fastp_min_kept_percentage = config.get("fastp_min_kept_percentage")
            for sample in list(passed_samples):
                json_file = f"{results_dir}/{sample}/fastp/{sample}_fastp.json"
                try:
                    with open(json_file) as fh:
                        data = json.load(fh)
                except FileNotFoundError:
                    #Missing JSON
                    passed_samples.remove(sample)
                    failures[sample] = {
                        "reason": "fastp_missing_json",
                        "message": json_file + " not found"
                    }
                    continue

                before_reads = data.get("summary", {}).get("before_filtering", {}).get("total_reads", 0)
                after_reads = data.get("summary", {}).get("after_filtering", {}).get("total_reads", 0)
                kept_percentage = (after_reads / before_reads) * 100 if before_reads else 0.0
                if kept_percentage < fastp_min_kept_percentage:
                    passed_samples.remove(sample)
                    failures[sample] = {
                        "reason": "fastp",
                        "kept_percentage": kept_percentage,
                        "threshold": fastp_min_kept_percentage,
                    }

        #Centrifuge QC
        if centrifuge_qc_is_configured:
            centrifuge_organism = config.get("centrifuge_organism", "")
            centrifuge_min_percentage = config.get("centrifuge_min_percentage")
            for sample in list(passed_samples):
                report_file = f"{results_dir}/{sample}/centrifuge/{sample}_report.txt"
                found_perc = 0.0
                organism_found = False
                try:
                    with open(report_file) as fh:
                        for line in fh:
                            if centrifuge_organism and centrifuge_organism in line:
                                try:
                                    found_perc = float(line.split()[0])
                                except Exception:
                                    found_perc = 0.0
                                if found_perc >= centrifuge_min_percentage:
                                    organism_found = True
                                break
                except FileNotFoundError:
                    #Missing centrifuge output
                    passed_samples.remove(sample)
                    failures[sample] = {
                        "reason": "centrifuge_missing_report",
                        "message": report_file + " not found"
                    }
                    continue

                if centrifuge_organism and not organism_found:
                    passed_samples.remove(sample)
                    failures[sample] = {
                        "reason": "centrifuge",
                        "found": found_perc,
                        "threshold": centrifuge_min_percentage,
                    }

        #Collect passed samples
        for s in passed_samples:
            sentinel = os.path.join("checkpoints", "passed", f"{s}.pass")
            open(sentinel, "w").close()

        #Summary for failed samples
        failures_file = "checkpoints/qc_failures.json"
        with open(failures_file, "w") as fh:
            json.dump(failures, fh, indent=2)

####Helper functions for collecting samples that passed QC
#Get samples that went through the checkpoints successfully to use for rule all
def get_passed_samples_from_checkpoint(wildcards):
    files = sorted(glob.glob("checkpoints/passed/*.pass"))
    samples = [os.path.splitext(os.path.basename(p))[0] for p in files]
    return samples

def get_first_passed_sample(wildcards):
    passed = get_passed_samples_from_checkpoint(wildcards)
    return passed[0] if passed else None

def get_rna_seq_outputs(wildcards):
    passed_samples = get_passed_samples_from_checkpoint(wildcards)
    #If none pass, it'll just return the failures file
    if not passed_samples:
        return ["checkpoints/qc_failures.json"]

    outputs = []
    for s in passed_samples:
        outputs.extend([
            f"{results_dir}/{s}/vg/{s}.gam",
            f"{results_dir}/{s}/vg/{s}_sort.bam",
            f"{results_dir}/{s}/vg/{s}_giraffe.stats.txt",
            f"{results_dir}/{s}/rseqc/{s}_infer_experiment.txt",
            f"{results_dir}/{s}/feature_overlap/{s}_feature_overlap_mqc.tsv",
        ])
    outputs.extend([
        f"{results_dir}/all_samples_raw_counts.txt",
        f"{results_dir}/multiqc_report.html",
        f"{results_dir}/deseq2/normalized_counts.tsv",
        "checkpoints/qc_failures.json",
    ])
    return outputs

####Rule all
rule all:
    input:
        lambda wc: get_rna_seq_outputs(wc)


####Fetching and merging raw reads (only for samples that need it)
# One job per run. sra-tools write both mates of a run in one go, so a paired run is one job with
# two outputs; `sra_download_se` fetches mate 1 only.
rule sra_download:
    output:
        r1=os.path.join(SRA_DIR, "{run}", "{run}_1.fastq.gz"),
        r2=os.path.join(SRA_DIR, "{run}", "{run}_2.fastq.gz")
    wildcard_constraints:
        run="|".join(SRA_RUNS_PE) or "no_paired_run"
    params:
        fetch=lambda wc: sra_fetch_params(wc.run, ("1", "2")),
        out_dir=lambda wc: os.path.join(SRA_DIR, wc.run)
    threads: 4
    resources:
        download_slots=1
    retries: 2
    shell:
        """
        python {scripts_dir}/sra_reads.py fetch --run {wildcards.run} --out-dir {params.out_dir} --mates 1,2 \
            --method {SRA_METHOD} --threads {threads} --spots {params.fetch[spots]} --ena {params.fetch[ena]:q}
        """

rule sra_download_se:
    output:
        os.path.join(SRA_DIR, "{run}", "{run}_1.fastq.gz")
    wildcard_constraints:
        run="|".join(SRA_RUNS_SE) or "no_single_run"
    params:
        fetch=lambda wc: sra_fetch_params(wc.run, ("1",)),
        out_dir=lambda wc: os.path.join(SRA_DIR, wc.run)
    threads: 4
    resources:
        download_slots=1
    retries: 2
    shell:
        """
        python {scripts_dir}/sra_reads.py fetch --run {wildcards.run} --out-dir {params.out_dir} --mates 1 \
            --method {SRA_METHOD} --threads {threads} --spots {params.fetch[spots]} --ena {params.fetch[ena]:q}
        """

rule merge_reads:
    input:
        lambda wc: READS[wc.sample]["r1" if wc.mate == "1" else "r2"]
    output:
        temp(f"{results_dir}/{{sample}}/raw/{{sample}}_R{{mate}}.{{ext}}")
    shell:
        """
        cat {input} > {output}
        """


####Single-end analysis
if SE:
    rule fastp_se:
        input:
            r1=lambda wildcards: raw_reads(wildcards.sample, 1)
        output:
            temp(f"{results_dir}/{{sample}}/{{sample}}_clean_R1.fastq"),
            html=f"{results_dir}/{{sample}}/fastp/{{sample}}_fastp.html",
            json=f"{results_dir}/{{sample}}/fastp/{{sample}}_fastp.json"
        threads: 12
        benchmark: f"benchmarks/{{sample}}_fastp_benchmark.txt"
        shell:
            """
            mkdir -p {results_dir}/{wildcards.sample}/fastp
            fastp -i {input.r1} -o {output[0]} -h {output.html} -j {output.json} -w {threads}
            """

    rule fastqc_se:
        input:
            r1=f"{results_dir}/{{sample}}/{{sample}}_clean_R1.fastq"
        output:
            html=f"{results_dir}/{{sample}}/fastqc/{{sample}}_clean_R1_fastqc.html",
            zip=f"{results_dir}/{{sample}}/fastqc/{{sample}}_clean_R1_fastqc.zip"
        shell:
            "fastqc {input.r1} -o {results_dir}/{wildcards.sample}/fastqc"

    rule centrifuge_se:
        input:
            r1 = f"{results_dir}/{{sample}}/{{sample}}_clean_R1.fastq",
        output:
            temp_report = temp(f"{results_dir}/{{sample}}/centrifuge/initial.tsv"),
            temp_reads = temp(f"{results_dir}/{{sample}}/centrifuge/good_read.txt"),
            temp_fastq = temp(f"{results_dir}/{{sample}}/centrifuge/_unambiguous.fastq"),
            tsv        = temp(f"{results_dir}/{{sample}}/centrifuge/{{sample}}_output.tsv"),
            report    = f"{results_dir}/{{sample}}/centrifuge/{{sample}}_report.txt",
        params:
            db = centrifuge_index_path,
        threads: 12
        benchmark: f"benchmarks/{{sample}}_centrifuge_benchmark.txt"
        shell:
            r"""
            mkdir -p {results_dir}/{wildcards.sample}/centrifuge
            centrifuge -x {params.db} -U {input.r1} -S {output.temp_report} -p {threads} --report-file {results_dir}/{wildcards.sample}/centrifuge/{wildcards.sample}_prefilter_abundance.tsv >/dev/null 2>&1
            awk 'NR>1 && $3!=0 && $8==1 {{print $1}}' {output.temp_report} | sort -u > {output.temp_reads}
            awk 'BEGIN {{ while ((getline < "{output.temp_reads}")>0) keep[$1]=1 }} NR%4==1 {{ rid=substr($1,2); keep_read=(rid in keep) }} keep_read {{print}}' {input.r1} > {output.temp_fastq}
            centrifuge -x {params.db} -U {output.temp_fastq} -S {output.tsv} -p {threads} --report-file {results_dir}/{wildcards.sample}/centrifuge/{wildcards.sample}_abundance.tsv >/dev/null 2>&1
            centrifuge-kreport -x {params.db} {output.tsv} > {output.report}
            """

    rule vg_giraffe_se:
        input:
            r1=lambda wc: f"{results_dir}/{wc.sample}/{wc.sample}_clean_R1.fastq",
            passed_qc=lambda wc: f"checkpoints/passed/{wc.sample}.pass"
        output:
            gam=f"{results_dir}/{{sample}}/vg/{{sample}}.gam"
        params:
            graph=vg_index+".d2.gbz",
            dist=vg_index+".d2.dist",
            min=lambda wc: get_minimizer_for_sample(wc.sample)
        threads: 12
        benchmark: f"benchmarks/{{sample}}_giraffe_benchmark.txt"
        shell:
            """
            mkdir -p {results_dir}/{wildcards.sample}/vg
            vg giraffe -Z {params.graph} -f {input.r1} -d {params.dist} -m {params.min} -t {threads} -o GAM > {output.gam}
            """
    
    rule vg_surject_se:
        input:
            gam=f"{results_dir}/{{sample}}/vg/{{sample}}.gam",
            passed_qc=lambda wc: f"checkpoints/passed/{wc.sample}.pass"
        output:
            bam=temp(f"{results_dir}/{{sample}}/vg/{{sample}}.bam")
        params:
            graph=vg_index+".d2.gbz",
            gref=gref,
            strip_prefix="#".join(gref.split("#")[:-1]) + "#"
        threads: 12
        benchmark: f"benchmarks/{{sample}}_surject_benchmark.txt"
        shell:
            """
            vg surject -x {params.graph} -b -p {params.gref} -t {threads} {input.gam} | \
            samtools view -h - | \
            sed 's/{params.strip_prefix}//g' | \
            samtools view -b - > {output.bam}
            """

####Paired-end analysis
else:
    rule fastp_pe:
        input:
            r1=lambda wildcards: raw_reads(wildcards.sample, 1),
            r2=lambda wildcards: raw_reads(wildcards.sample, 2)
        output:
            r1=temp(f"{results_dir}/{{sample}}/{{sample}}_clean_R1.fastq"),
            r2=temp(f"{results_dir}/{{sample}}/{{sample}}_clean_R2.fastq"),
            html=f"{results_dir}/{{sample}}/fastp/{{sample}}_fastp.html",
            json=f"{results_dir}/{{sample}}/fastp/{{sample}}_fastp.json"
        threads: 12
        benchmark: f"benchmarks/{{sample}}_fastp_benchmark.txt"
        # --detect_adapter_for_pe (config `fastp_detect_adapter_for_pe`, default off): without it
        # fastp removes paired-end adapters only where the two mates overlap, which misses inserts
        # shorter than about 30 bp; those reads are then almost all adapter, are classified as
        # vector sequence by Centrifuge and do not align.
        params:
            extra=fastp_pe_extra
        shell:
            """
            mkdir -p {results_dir}/{wildcards.sample}/fastp
            fastp -i {input.r1} -I {input.r2} -o {output.r1} -O {output.r2} -h {output.html} -j {output.json} -w {threads} {params.extra}
            """

    rule fastqc_pe:
        input:
            r1=f"{results_dir}/{{sample}}/{{sample}}_clean_R1.fastq",
            r2=f"{results_dir}/{{sample}}/{{sample}}_clean_R2.fastq"
        output:
            r1_html=f"{results_dir}/{{sample}}/fastqc/{{sample}}_clean_R1_fastqc.html",
            r1_zip=f"{results_dir}/{{sample}}/fastqc/{{sample}}_clean_R1_fastqc.zip",
            r2_html=f"{results_dir}/{{sample}}/fastqc/{{sample}}_clean_R2_fastqc.html",
            r2_zip=f"{results_dir}/{{sample}}/fastqc/{{sample}}_clean_R2_fastqc.zip"
        shell:
            r"""
            mkdir -p {results_dir}/{wildcards.sample}/fastqc
            fastqc {input.r1} -o {results_dir}/{wildcards.sample}/fastqc
            fastqc {input.r2} -o {results_dir}/{wildcards.sample}/fastqc
            """

    rule centrifuge_pe:
        input:
            r1 = f"{results_dir}/{{sample}}/{{sample}}_clean_R1.fastq",
            r2 = f"{results_dir}/{{sample}}/{{sample}}_clean_R2.fastq"
        output:
            temp_report = temp(f"{results_dir}/{{sample}}/centrifuge/initial.tsv"),
            temp_reads = temp(f"{results_dir}/{{sample}}/centrifuge/good_reads.txt"),
            temp_fastq_r1 = temp(f"{results_dir}/{{sample}}/centrifuge/clean_R1_unambiguous.fastq"),
            temp_fastq_r2 = temp(f"{results_dir}/{{sample}}/centrifuge/clean_R2_unambiguous.fastq"),
            tsv = temp(f"{results_dir}/{{sample}}/centrifuge/{{sample}}_output.tsv"),
            report = f"{results_dir}/{{sample}}/centrifuge/{{sample}}_report.txt"
        params:
            db = centrifuge_index_path,
        threads: 12
        benchmark: f"benchmarks/{{sample}}_centrifuge_benchmark.txt"
        shell:
            r"""
            mkdir -p {results_dir}/{wildcards.sample}/centrifuge
            centrifuge -x {params.db} -1 {input.r1} -2 {input.r2} -S {output.temp_report} -p {threads} --report-file {results_dir}/{wildcards.sample}/centrifuge/{wildcards.sample}_prefilter_abundance.tsv >/dev/null 2>&1
            awk 'NR>1 && $3!=0 && $8==1 {{print $1}}' {output.temp_report} | sort -u > {output.temp_reads}
            awk 'BEGIN {{ while ((getline < "{output.temp_reads}")>0) keep[$1]=1 }} NR%4==1 {{ rid=substr($1,2); keep_read=(rid in keep) }} keep_read {{print}}' {input.r1} > {output.temp_fastq_r1}
            awk 'BEGIN {{ while ((getline < "{output.temp_reads}")>0) keep[$1]=1 }} NR%4==1 {{ rid=substr($1,2); keep_read=(rid in keep) }} keep_read {{print}}' {input.r2} > {output.temp_fastq_r2}
            centrifuge -x {params.db} -1 {output.temp_fastq_r1} -2 {output.temp_fastq_r2} -S {output.tsv} -p {threads} --report-file {results_dir}/{wildcards.sample}/centrifuge/{wildcards.sample}_abundance.tsv >/dev/null 2>&1
            centrifuge-kreport -x {params.db} {output.tsv} > {output.report}
            """
            
    rule vg_giraffe_pe:
        input:
            r1=lambda wc: f"{results_dir}/{wc.sample}/{wc.sample}_clean_R1.fastq",
            r2=lambda wc: f"{results_dir}/{wc.sample}/{wc.sample}_clean_R2.fastq",
            passed_qc=lambda wc: f"checkpoints/passed/{wc.sample}.pass"
        output:
            gam=f"{results_dir}/{{sample}}/vg/{{sample}}.gam"
        params:
            graph=vg_index+".d2.gbz",
            dist=vg_index+".d2.dist",
            min=lambda wc: get_minimizer_for_sample(wc.sample)
        threads: 12
        benchmark: f"benchmarks/{{sample}}_giraffe_benchmark.txt"
        shell:
            """
            mkdir -p {results_dir}/{wildcards.sample}/vg
            vg giraffe -Z {params.graph} -f {input.r1} -f {input.r2} -d {params.dist} -m {params.min} -t {threads} -o GAM > {output.gam}
            """
    
    rule vg_surject_pe:
        input:
            gam=f"{results_dir}/{{sample}}/vg/{{sample}}.gam",
            passed_qc=lambda wc: f"checkpoints/passed/{wc.sample}.pass"
        output:
            bam=temp(f"{results_dir}/{{sample}}/vg/{{sample}}.bam")
        params:
            graph=vg_index + ".d2.gbz",
            gref=gref,
            strip_prefix="#".join(gref.split("#")[:-1]) + "#"
        threads: 12
        benchmark: f"benchmarks/{{sample}}_surject_benchmark.txt"
        shell:
            """
            vg surject -x {params.graph} -b -i -p {params.gref} -t {threads} {input.gam} | \
            samtools view -h - | \
            sed 's/{params.strip_prefix}//g' | \
            samtools view -b - > {output.bam}
            """

####Not PE/SE specific rules
#Getting statistics for vg alignment
rule vg_stats:
    input:
        gam=f"{results_dir}/{{sample}}/vg/{{sample}}.gam"
    output:
        txt=f"{results_dir}/{{sample}}/vg/{{sample}}_giraffe.stats.txt"
    #Add time information at end to meet multiqc requirements
    shell:
        """
        vg stats -a {input.gam} > {output.txt}
        echo "Total time: 123 seconds" >> {output.txt}
        echo "Speed: 123 reads/second" >> {output.txt}
        """

#Getting strandedness information for sequencing library (used by multiqc)
rule rseqc:
    input:
        bam = f"{results_dir}/{{sample}}/vg/{{sample}}.bam"
    output:
        infer_experiment = f"{results_dir}/{{sample}}/rseqc/{{sample}}_infer_experiment.txt",
        genebody_cov_txt = f"{results_dir}/{{sample}}/rseqc/{{sample}}_genebody_cov.geneBodyCoverage.txt",
        genebody_cov_r = f"{results_dir}/{{sample}}/rseqc/{{sample}}_genebody_cov.geneBodyCoverage.r",
        sorted_bam = f"{results_dir}/{{sample}}/vg/{{sample}}_sort.bam",
        bam_index = f"{results_dir}/{{sample}}/vg/{{sample}}_sort.bam.bai"
    params:
        annotation_bed = annotation_bed
    benchmark: f"benchmarks/{{sample}}_rseqc_benchmark.txt"
    shell:
        r"""
        mkdir -p {results_dir}/{wildcards.sample}/rseqc
        infer_experiment.py -i {input.bam} -r {params.annotation_bed} > {output.infer_experiment}
        samtools sort {input.bam} > {output.sorted_bam}
        samtools index {output.sorted_bam}
        grep "gene" {params.annotation_bed} > {results_dir}/{wildcards.sample}/rseqc/genes.bed
        # run inside the rseqc directory: geneBody_coverage.py writes a log.txt into the cwd
        (cd {results_dir}/{wildcards.sample}/rseqc && geneBody_coverage.py -r genes.bed -i ../vg/{wildcards.sample}_sort.bam -o {wildcards.sample}_genebody_cov)
        """


####Rules that require all samples in an experiment
rule featurecounts_combined:
    input:
        bams=lambda wc: expand(
            f"{results_dir}/{{sample}}/vg/{{sample}}_sort.bam",
            sample=get_passed_samples_from_checkpoint(wc)
        ),
        infer_experiment_for_strand=lambda wc:
            f"{results_dir}/{get_first_passed_sample(wc)}/rseqc/{get_first_passed_sample(wc)}_infer_experiment.txt"
    output:
        counts=f"{results_dir}/all_samples_raw_counts.txt",
        summary=f"{results_dir}/all_samples_raw_counts.txt.summary",
        temp_gff=f"{results_dir}/featurecounts/featurecounts_annotation.gff"
    params:
        pe_param = "-p" if not SE else ""
    benchmark: f"benchmarks/featurecounts_benchmark.txt"
    shell:
        r"""
        mkdir -p $(dirname {output.counts}) $(dirname {output.temp_gff})
    
        strand=$(awk '
          /1\+\+,1--/ || /\+\+,--/ {{ strand1 = $NF + 0 }}
          /1\+-,1-\+/ || /\+\-,-\+/ {{ strand2 = $NF + 0 }}
          END {{
            if (strand1 > 80) print 1;
            else if (strand2 > 80) print 2;
            else print 0;
          }}' {input.infer_experiment_for_strand})
    
        # Annotation uses generic type "feature" for every row; classify by gbkey instead.
        #   gbkey=Gene  -> gene-level rows (protein_coding, rRNA, tRNA, pseudogene, ncRNA, ...)
        #   gbkey=ncRNA -> RefSeq ncRNA transcripts and Rfam ncRNA predictions
        # Unstranded: count genes only, excluding ncRNA genes.
        # Stranded:   count non-ncRNA genes plus all gbkey=ncRNA rows (RefSeq ncRNA genes are
        #             replaced by their ncRNA transcript rows to avoid double entries).
        # Selected rows are retyped to "gene" so featureCounts -t gene picks them up.
        # Features are named by gene symbol (the Name attribute), so the Geneid column of the
        # counts table matches the gene symbols used in the previous counts tables. Rows without
        # a Name get one: RefSeq ncRNA transcripts use their gene= attribute (same symbol as the
        # gene row they replace); Rfam rows use their ID (e.g. Thr_leader, ES036_1), with an
        # "_Rfam" suffix if that ID collides with a gene symbol (e.g. greA, nuoG, rimP).
        awk -F"\t" -v strand="$strand" 'BEGIN{{OFS="\t"}}
          /^#/ || NF != 9 {{next}}
          NR == FNR {{
            if ($9 ~ /(^|;)gbkey=Gene(;|$)/ && $9 ~ /(^|;)Name=/) {{
              nm = $9; sub(/^(.*;)?Name=/, "", nm); sub(/;.*$/, "", nm); gene_names[nm] = 1
            }}
            next
          }}
          {{
            is_gene  = ($9 ~ /(^|;)gbkey=Gene(;|$)/)
            is_ncrna = ($9 ~ /(^|;)gbkey=ncRNA(;|$)/)
            nc_gene  = is_gene && ($9 ~ /(^|;)gene_biotype=ncRNA(;|$)/)
            if (strand == 0) {{ if (!is_gene || nc_gene) next }}
            else {{ if (!(is_gene && !nc_gene) && !is_ncrna) next }}
            if ($9 !~ /(^|;)Name=/) {{
              if ($9 ~ /(^|;)gene=/) {{
                nm = $9; sub(/^(.*;)?gene=/, "", nm); sub(/;.*$/, "", nm)
              }} else {{
                nm = $9; sub(/^(.*;)?ID=/, "", nm); sub(/;.*$/, "", nm)
                if (nm in gene_names) nm = nm "_Rfam"
              }}
              $9 = $9 ";Name=" nm
            }}
            $3 = "gene"
            print
          }}' {annotation_gff} {annotation_gff} > {output.temp_gff}
        featureCounts -a {output.temp_gff} -o {output.counts} -t gene -g Name -s "$strand" {params.pe_param} {input.bams}
        """
        
#Sample metadata for DESeq2        
rule generate_sample_metadata:
    output:
        temp(f"{results_dir}/sample_metadata.tsv")
    run:
        import pandas as pd

        samples = config["samples"]

        #Use only passed samples
        passed_samples = get_passed_samples_from_checkpoint(None)

        metadata = []
        for sample_id in passed_samples:
            info = samples[sample_id]
            row = {"sample_id": sample_id}
            row["condition"] = info.get("condition", "NA")
            if "condition2" in info:
                row["condition2"] = info["condition2"]
            metadata.append(row)

        df = pd.DataFrame(metadata)
        df.to_csv(output[0], sep="\t", index=False)
        

#Running DEseq using comparison listed in config file
deseq_results_outputs = expand(f"{results_dir}/deseq2/{{contrast}}_deseq_results.tsv", contrast=contrast_names) #Need a list of outputs from contrasts
deseq_summary_outputs = expand(f"{results_dir}/deseq2/{{contrast}}_deseq_results_summary.tsv", contrast=contrast_names)
rule run_deseq2:
    input:
        counts=f"{results_dir}/all_samples_gene_symbols.tsv",
        metadata=f"{results_dir}/sample_metadata.tsv",
        extended=f"{results_dir}/all_samples_counts_extended.tsv"
    output:
        pca_coords=f"{results_dir}/deseq2/pca_coordinates.tsv",
        pca_plot=f"{results_dir}/deseq2/pca_plot.png",
        pca_mqc = f"{results_dir}/deseq2/pca_mqc.tsv",
        norm_counts=f"{results_dir}/deseq2/normalized_counts.tsv",
        results = deseq_results_outputs
    params:
        outdir=f"{results_dir}/deseq2",
        contrasts_json=json.dumps(deseq2_contrasts)
    benchmark: f"benchmarks/deseq_benchmark.txt"
    shell:
        """
        mkdir -p {params.outdir}

        Rscript {scripts_dir}/run_deseq2.R {input.counts} {input.metadata} {params.outdir} '{params.contrasts_json}'

        cat {scripts_dir}/pca_header.txt <(
            echo -e "id\\tPC1\\tPC2\\tcondition"
            sed '1d' {output.pca_coords} | awk 'BEGIN{{OFS="\\t"}} {{print $1, $2, $3, $NF}}'
        ) > {output.pca_mqc}
        """
        
