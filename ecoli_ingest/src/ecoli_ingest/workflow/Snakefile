###Getting config information

import glob, gzip, json, os, sys

configfile: "config.yaml"
experiment_name = config.get("experiment", "experiment_unknown")
# Results directory inside the run directory: <experiment>_results unless `results_dir` is set.
results_dir = (config.get("results_dir") or f"{experiment_name}_results").rstrip("/")

# Resource files default to the standard layout under `resources_dir` (the ecoli_ingest launcher
# passes --config resources_dir=...). An explicit per-file entry in config.yaml still wins.
# Keep these relative paths in sync with ecoli_ingest/paths.py (RESOURCE_FILES).
resources_dir = config.get("resources_dir", "../resources")
def _resource(key, relpath):
    return config.get(key) or os.path.join(resources_dir, relpath)

# Counting annotation and its BED12 twin, both written by ecoli_ingest/build/build_annotation.py.
annotation_gff = _resource("annotation_gff", "annotation/GCF_000005845.2_ASM584v2_counting_v2.gff")
annotation_bed = _resource("annotation_bed", "annotation/GCF_000005845.2_ASM584v2_counting_v2.bed")
vg_index = _resource("vg_index", "vg/ecoli_graph_test")
centrifuge_index_path = _resource("centrifuge_index_path", "centrifuge/p_compressed+h+v")

# `vg_index_local: true` copies the vg index (0.7 GB) to this node's temporary directory and uses
# the copy. vg giraffe memory-maps the distance index; from a network file system that can stall
# completely when several nodes align at the same time (seen on GPFS with 20 nodes). A directory
# can be given instead of `true`.
def _local_vg_index(index, where):
    import shutil, tempfile
    if where is True:
        where = os.path.join(os.environ.get("TMPDIR") or tempfile.gettempdir(), "ecoli_ingest_vg")
    os.makedirs(where, exist_ok=True)
    for suffix in (".d2.gbz", ".d2.dist", ".d2.min", ".d2.k15.min", ".d2.shortread.zipcodes"):
        src, dst = index + suffix, os.path.join(where, os.path.basename(index) + suffix)
        if not os.path.exists(src):
            continue
        if not (os.path.exists(dst) and os.path.getsize(dst) == os.path.getsize(src)):
            tmp = f"{dst}.{os.getpid()}.tmp"
            shutil.copy2(src, tmp)
            os.replace(tmp, dst)
    print(f"vg index copied to {where}", file=sys.stderr, flush=True)
    return os.path.join(where, os.path.basename(index))

if config.get("vg_index_local"):
    vg_index = _local_vg_index(vg_index, config["vg_index_local"])
gref = config.get("ref", "GCF_000005845_2_ASM584v2_genomic#0#NC_000913.3")
linear_index = config.get("linear", None)
# Workflow scripts live next to this Snakefile; override only for development.
scripts_dir = config.get("scripts_dir") or os.path.join(workflow.basedir, "scripts")

#Getting read length for vg minimizer
def get_minimizer_for_sample(sample_name):
    fastq_path = None
    cleaned_path = f"{results_dir}/{sample_name}/{sample_name}_clean_R1.fastq.gz"
    
    if os.path.exists(cleaned_path):
        fastq_path = cleaned_path
    
    if fastq_path is None or not os.path.exists(fastq_path):
        print(f"Warning: Could not find fastq for {sample_name}, using default minimizer", flush=True)
        return vg_index + ".d2.min"
    
    total_length = 0
    read_count = 0
    max_reads = 1000
    
    try:
        with gzip.open(fastq_path, 'rt') as f:
            for i, line in enumerate(f):
                if i % 4 == 1:
                    total_length += len(line.strip())
                    read_count += 1
                    if read_count >= max_reads:
                        break
        
        if read_count > 0:
            avg_length = total_length / read_count
            print(f"Sample {sample_name}: Average read length = {avg_length:.1f}bp", flush=True)
            
            if avg_length < 50:
                print(f"Using shortest read minimizer (k=15)", flush=True)
                return vg_index + ".d2.k15.min"
            else:
                print(f"Using standard minimizer (k=29)", flush=True)
                return vg_index + ".d2.min"
    except Exception as e:
        return vg_index + ".d2.min"


#Where each sample's reads come from (scripts/sra_reads.py is shared with `ecoli_ingest check`).
# A sample gives r1/r2 (a file or a list of files per mate, concatenated before fastp) or an
# `accession` (SRR/SRX/SRS/GSM) whose reads are fetched into `sra_dir`: with sra-tools (prefetch +
# fasterq-dump) first and the ENA FASTQ files as the backup (`sra_method: auto`, the default), or
# from one source only (`sra_method: sra-tools` / `ena`). Resolving an accession needs the network
# once; the answer is cached under <sra_dir>/manifest/<ACC>.json.
sys.path.insert(0, scripts_dir)
import sra_reads
import call_strandedness

SAMPLES = config.get("samples", {})
SRA_DIR = config.get("sra_dir", "sra")
READS = sra_reads.resolve_samples(SAMPLES, SRA_DIR, os.path.join(SRA_DIR, "manifest"), log=sys.stderr)
RUN_FILES = {run: files for spec in READS.values() for run, files in spec["runs"].items()}
RUN_SPOTS = {run: n for spec in READS.values() for run, n in spec.get("spots", {}).items()}
SRA_METHOD = sra_reads.check_method(config.get("sra_method", "auto"))

# Concurrent downloads are capped by the `download_slots` resource: `--resources download_slots=N`
# (the launcher's --max-downloads) wins, else config `max_downloads`, else 4.
if "download_slots" not in workflow.global_resources:
    workflow.register_resource("download_slots", int(config.get("max_downloads", 4)))

#Getting SE or PE
num_se = sum(spec["r2"] is None for spec in READS.values())
num_pe = len(READS) - num_se
SE = num_se > 0

# Runs to fetch, by the mates the workflow reads: both, or mate 1 only (single-end runs, and
# paired runs when the whole run is treated as single-end).
SRA_RUNS_PE = sorted(RUN_FILES) if not SE else []
SRA_RUNS_SE = sorted(RUN_FILES) if SE else []

def sra_fetch_params(run, mates):
    """Arguments of `sra_reads.py fetch` for one run."""
    ena = {m: RUN_FILES[run][m] for m in mates if m in RUN_FILES[run]}
    return {"ena": json.dumps(ena, separators=(",", ":")), "spots": RUN_SPOTS.get(run) or 0}
if num_se > 0 and num_pe > 0:
    print("WARNING: Mixed SE and PE samples detected. Defaulting to SE mode for all.", flush=True)

def raw_reads(sample, mate):
    """The file fastp reads for one mate: the configured/downloaded file itself when there is
    exactly one, otherwise the concatenation made by merge_reads."""
    files = READS[sample]["r1" if mate == 1 else "r2"]
    if len(files) == 1:
        return files[0]
    ext = "fastq.gz" if sra_reads.is_gz(files[0]) else "fastq"
    return f"{results_dir}/{sample}/raw/{sample}_R{mate}.{ext}"

wildcard_constraints:
    sample="[^/]+",
    run="[SED]RR[0-9]+",
    mate="[12]",
    ext="fastq(\\.gz)?"


# The sorted BAM (<sample>_sort.bam) is kept unless `keep_alignments: false`. It is then removed
# as soon as every step that reads it has finished; the QC record and the coverage track (rules
# bam_qc, sample_qc) hold what is needed from it. The .gam is always removed once used.
keep_alignments = bool(config.get("keep_alignments", True))
def alignment(path):
    return path if keep_alignments else temp(path)

#Getting contrasts
deseq2_contrasts = config.get("deseq2", {}).get("contrasts", [])
contrast_names = [f"{ref}_vs_{test}" for factor, ref, test in deseq2_contrasts]


#QC checkpoint on/off
fastp_qc_is_configured = config.get("fastp_min_kept_percentage") is not None
# Centrifuge runs unless `centrifuge: false`. With it on, the species gate applies unless
# `species_gate: false`: a sample that is not E. coli (another organism, a phage infection, a
# mixture) is not counted. Samples that are clearly something else are stopped before alignment
# (rule species_early); the full rule is applied after alignment (rule species_qc), where the reads
# on rRNA / tRNA genes can be left out. See scripts/species_metrics.py and docs/prescreen.md.
centrifuge_enabled = bool(config.get("centrifuge", True))
species_gate = centrifuge_enabled and bool(config.get("species_gate", True))
species_thresholds = json.dumps(config.get("species_thresholds") or {}, separators=(",", ":"))
for _old in ("centrifuge_organism", "centrifuge_min_percentage"):
    if _old in config:
        print(f"WARNING: config key `{_old}` is ignored; the Centrifuge gate is now the species gate "
              "(`species_gate`, `species_thresholds`).", file=sys.stderr, flush=True)
# Strand specificity: inGEST counts strand-specific libraries only. `strandedness: auto` (default)
# calls each sample from RSeQC infer_experiment; `forward` / `reverse` state it for the whole run.
strandedness_mode = str(config.get("strandedness", "auto")).lower()
if strandedness_mode not in ("auto", "forward", "reverse"):
    raise ValueError(f"config `strandedness` must be auto, forward or reverse, not {strandedness_mode!r}")
strandedness_min_fraction = float(config.get("strandedness_min_fraction", 0.8))
if "fastp_detect_adapter_for_pe" in config:
    print("WARNING: config key `fastp_detect_adapter_for_pe` is ignored; paired-end adapter "
          "detection is always on.", file=sys.stderr, flush=True)


###Checkpoint function for QC metrics collected above (fastp and centrifuge)
checkpoint qc_passed_samples:
    input:
        fastp_json=lambda wc: [
            f"{results_dir}/{s}/fastp/{s}_fastp.json" for s in SAMPLES.keys()
        ] if fastp_qc_is_configured else [],
        species_early=lambda wc: [
            f"{results_dir}/{s}/qc/{s}_species_early.json" for s in SAMPLES.keys()
        ] if species_gate else []
    output:
        directory("checkpoints/passed/"),
        "checkpoints/qc_failures.json"
    run:
        import os, json
        os.makedirs("checkpoints/passed", exist_ok=True)
        failures = {}
        passed_samples = set(SAMPLES.keys())

        #Fastp
        if fastp_qc_is_configured:
            fastp_min_kept_percentage = config.get("fastp_min_kept_percentage")
            for sample in list(passed_samples):
                json_file = f"{results_dir}/{sample}/fastp/{sample}_fastp.json"
                try:
                    with open(json_file) as fh:
                        data = json.load(fh)
                except FileNotFoundError:
                    #Missing JSON
                    passed_samples.remove(sample)
                    failures[sample] = {
                        "reason": "fastp_missing_json",
                        "message": json_file + " not found"
                    }
                    continue

                before_reads = data.get("summary", {}).get("before_filtering", {}).get("total_reads", 0)
                after_reads = data.get("summary", {}).get("after_filtering", {}).get("total_reads", 0)
                kept_percentage = (after_reads / before_reads) * 100 if before_reads else 0.0
                if kept_percentage < fastp_min_kept_percentage:
                    passed_samples.remove(sample)
                    failures[sample] = {
                        "reason": "fastp",
                        "kept_percentage": kept_percentage,
                        "threshold": fastp_min_kept_percentage,
                    }

        #Species gate, early part: samples that are clearly not E. coli are not aligned
        if species_gate:
            for sample in list(passed_samples):
                early_file = f"{results_dir}/{sample}/qc/{sample}_species_early.json"
                try:
                    with open(early_file) as fh:
                        early = json.load(fh)
                except FileNotFoundError:
                    passed_samples.remove(sample)
                    failures[sample] = {"reason": "species_missing_file", "message": early_file + " not found"}
                    continue
                if early.get("verdict_early") not in ("ok", "no_species"):
                    passed_samples.remove(sample)
                    failures[sample] = {
                        "reason": "species",
                        "verdict": early.get("verdict_early"),
                        "pct_escherichia_shigella": early.get("pct_escherichia_shigella"),
                        "top_other_genus": early.get("top_other_genus"),
                        "pct_top_other_genus": early.get("pct_top_other_genus"),
                    }

        #Collect passed samples
        for s in passed_samples:
            sentinel = os.path.join("checkpoints", "passed", f"{s}.pass")
            open(sentinel, "w").close()

        #Summary for failed samples
        failures_file = "checkpoints/qc_failures.json"
        with open(failures_file, "w") as fh:
            json.dump(failures, fh, indent=2)

####Helper functions for collecting samples that passed QC
#Get samples that went through the checkpoints successfully to use for rule all
def get_passed_samples_from_checkpoint(wildcards):
    files = sorted(glob.glob("checkpoints/passed/*.pass"))
    samples = [os.path.splitext(os.path.basename(p))[0] for p in files]
    return samples

STRAND_TABLE = f"{results_dir}/strandedness.tsv"

def get_counted_samples(wildcards):
    """QC-passed samples whose library is strand-specific; only these are counted. Waits for the
    strandedness checkpoint, so rules using it are planned after the calls are known."""
    table = checkpoints.strand_passed_samples.get().output.table
    return call_strandedness.counted_samples(table)

def get_rna_seq_outputs(wildcards):
    passed_samples = get_passed_samples_from_checkpoint(wildcards)
    #If none pass, it'll just return the failures file
    if not passed_samples:
        return ["checkpoints/qc_failures.json"]

    outputs = []
    for s in passed_samples:
        if keep_alignments:
            outputs.append(f"{results_dir}/{s}/vg/{s}_sort.bam")
        outputs.extend([
            f"{results_dir}/{s}/vg/{s}_giraffe.stats.txt",
            f"{results_dir}/{s}/rseqc/{s}_infer_experiment.txt",
            f"{results_dir}/{s}/feature_overlap/{s}_feature_overlap_mqc.tsv",
        ])
    outputs.extend([STRAND_TABLE, "checkpoints/qc_failures.json"])
    # Count tables, DESeq2 and the report need at least one strand-specific sample.
    if get_counted_samples(wildcards):
        outputs.extend([
            f"{results_dir}/all_samples_raw_counts.txt",
            f"{results_dir}/all_samples_antisense_counts.txt",
            f"{results_dir}/all_samples_counts_extended.tsv",
            f"{results_dir}/counting_method.json",
            f"{results_dir}/multiqc_report.html",
            f"{results_dir}/deseq2/normalized_counts.tsv",
        ])
        # per-sample QC record and coverage track (docs/atlas_qc_inputs.md)
        outputs.extend(f"{results_dir}/{s}/qc/{s}.qc.json" for s in get_counted_samples(wildcards))
    else:
        print("No strand-specific sample: nothing is counted. See " + STRAND_TABLE, file=sys.stderr, flush=True)
    return outputs

####Rule all
rule all:
    input:
        lambda wc: get_rna_seq_outputs(wc)


####Fetching and merging raw reads (only for samples that need it)
# One job per run. sra-tools write both mates of a run in one go, so a paired run is one job with
# two outputs; `sra_download_se` fetches mate 1 only.
rule sra_download:
    output:
        r1=os.path.join(SRA_DIR, "{run}", "{run}_1.fastq.gz"),
        r2=os.path.join(SRA_DIR, "{run}", "{run}_2.fastq.gz")
    wildcard_constraints:
        run="|".join(SRA_RUNS_PE) or "no_paired_run"
    params:
        fetch=lambda wc: sra_fetch_params(wc.run, ("1", "2")),
        out_dir=lambda wc: os.path.join(SRA_DIR, wc.run)
    threads: 4
    resources:
        download_slots=1
    retries: 2
    shell:
        """
        python {scripts_dir}/sra_reads.py fetch --run {wildcards.run} --out-dir {params.out_dir} --mates 1,2 \
            --method {SRA_METHOD} --threads {threads} --spots {params.fetch[spots]} --ena {params.fetch[ena]:q}
        """

rule sra_download_se:
    output:
        os.path.join(SRA_DIR, "{run}", "{run}_1.fastq.gz")
    wildcard_constraints:
        run="|".join(SRA_RUNS_SE) or "no_single_run"
    params:
        fetch=lambda wc: sra_fetch_params(wc.run, ("1",)),
        out_dir=lambda wc: os.path.join(SRA_DIR, wc.run)
    threads: 4
    resources:
        download_slots=1
    retries: 2
    shell:
        """
        python {scripts_dir}/sra_reads.py fetch --run {wildcards.run} --out-dir {params.out_dir} --mates 1 \
            --method {SRA_METHOD} --threads {threads} --spots {params.fetch[spots]} --ena {params.fetch[ena]:q}
        """

rule merge_reads:
    input:
        lambda wc: READS[wc.sample]["r1" if wc.mate == "1" else "r2"]
    output:
        temp(f"{results_dir}/{{sample}}/raw/{{sample}}_R{{mate}}.{{ext}}")
    shell:
        """
        cat {input} > {output}
        """


####Single-end analysis
if SE:
    rule fastp_se:
        input:
            r1=lambda wildcards: raw_reads(wildcards.sample, 1)
        output:
            temp(f"{results_dir}/{{sample}}/{{sample}}_clean_R1.fastq.gz"),
            html=f"{results_dir}/{{sample}}/fastp/{{sample}}_fastp.html",
            json=f"{results_dir}/{{sample}}/fastp/{{sample}}_fastp.json"
        threads: 12
        benchmark: f"benchmarks/{{sample}}_fastp_benchmark.txt"
        shell:
            """
            mkdir -p {results_dir}/{wildcards.sample}/fastp
            fastp -i {input.r1} -o {output[0]} -h {output.html} -j {output.json} -w {threads}
            """

    rule fastqc_se:
        input:
            r1=f"{results_dir}/{{sample}}/{{sample}}_clean_R1.fastq.gz"
        output:
            html=f"{results_dir}/{{sample}}/fastqc/{{sample}}_clean_R1_fastqc.html",
            zip=f"{results_dir}/{{sample}}/fastqc/{{sample}}_clean_R1_fastqc.zip"
        shell:
            "fastqc {input.r1} -o {results_dir}/{wildcards.sample}/fastqc"

    rule centrifuge_se:
        input:
            r1 = f"{results_dir}/{{sample}}/{{sample}}_clean_R1.fastq.gz",
        output:
            # first-pass classification of every read: read by species_early and species_qc
            classifications = temp(f"{results_dir}/{{sample}}/centrifuge/initial.tsv"),
            report    = f"{results_dir}/{{sample}}/centrifuge/{{sample}}_report.txt",
        params:
            db = centrifuge_index_path,
            # filtered reads and second-pass classifications (several GB): kept out of the declared
            # outputs and deleted at the end, because Snakemake keeps temp() files until the QC
            # checkpoint has run for every sample
            tmp = f"{results_dir}/{{sample}}/centrifuge/tmp",
        threads: 12
        benchmark: f"benchmarks/{{sample}}_centrifuge_benchmark.txt"
        shell:
            r"""
            rm -rf {params.tmp} && mkdir -p {params.tmp}
            centrifuge -x {params.db} -U {input.r1} -S {output.classifications} -p {threads} --report-file {results_dir}/{wildcards.sample}/centrifuge/{wildcards.sample}_prefilter_abundance.tsv >/dev/null 2>&1
            awk 'NR>1 && $3!=0 && $8==1 {{print $1}}' {output.classifications} | sort -u > {params.tmp}/good_reads.txt
            gzip -cd {input.r1} | awk 'BEGIN {{ while ((getline < "{params.tmp}/good_reads.txt")>0) keep[$1]=1 }} NR%4==1 {{ rid=substr($1,2); keep_read=(rid in keep) }} keep_read {{print}}' > {params.tmp}/unambiguous.fastq
            centrifuge -x {params.db} -U {params.tmp}/unambiguous.fastq -S {params.tmp}/output.tsv -p {threads} --report-file {results_dir}/{wildcards.sample}/centrifuge/{wildcards.sample}_abundance.tsv >/dev/null 2>&1
            centrifuge-kreport -x {params.db} {params.tmp}/output.tsv > {output.report}
            rm -rf {params.tmp}
            """

    rule vg_giraffe_se:
        input:
            r1=lambda wc: f"{results_dir}/{wc.sample}/{wc.sample}_clean_R1.fastq.gz",
            passed_qc=lambda wc: f"checkpoints/passed/{wc.sample}.pass"
        output:
            # several GB per sample and only read by vg surject and vg stats: removed once both ran
            gam=temp(f"{results_dir}/{{sample}}/vg/{{sample}}.gam")
        params:
            graph=vg_index+".d2.gbz",
            dist=vg_index+".d2.dist",
            min=lambda wc: get_minimizer_for_sample(wc.sample)
        threads: 12
        benchmark: f"benchmarks/{{sample}}_giraffe_benchmark.txt"
        shell:
            """
            mkdir -p {results_dir}/{wildcards.sample}/vg
            vg giraffe -Z {params.graph} -f {input.r1} -d {params.dist} -m {params.min} -t {threads} -o GAM > {output.gam}
            """
    
    rule vg_surject_se:
        input:
            gam=f"{results_dir}/{{sample}}/vg/{{sample}}.gam",
            passed_qc=lambda wc: f"checkpoints/passed/{wc.sample}.pass"
        output:
            bam=temp(f"{results_dir}/{{sample}}/vg/{{sample}}.bam")
        params:
            graph=vg_index+".d2.gbz",
            gref=gref,
            strip_prefix="#".join(gref.split("#")[:-1]) + "#"
        threads: 12
        benchmark: f"benchmarks/{{sample}}_surject_benchmark.txt"
        shell:
            """
            vg surject -x {params.graph} -b -p {params.gref} -t {threads} {input.gam} | \
            samtools view -h - | \
            sed 's/{params.strip_prefix}//g' | \
            samtools view -b - > {output.bam}
            """

####Paired-end analysis
else:
    rule fastp_pe:
        input:
            r1=lambda wildcards: raw_reads(wildcards.sample, 1),
            r2=lambda wildcards: raw_reads(wildcards.sample, 2)
        output:
            r1=temp(f"{results_dir}/{{sample}}/{{sample}}_clean_R1.fastq.gz"),
            r2=temp(f"{results_dir}/{{sample}}/{{sample}}_clean_R2.fastq.gz"),
            html=f"{results_dir}/{{sample}}/fastp/{{sample}}_fastp.html",
            json=f"{results_dir}/{{sample}}/fastp/{{sample}}_fastp.json"
        threads: 12
        benchmark: f"benchmarks/{{sample}}_fastp_benchmark.txt"
        # --detect_adapter_for_pe: without it fastp removes paired-end adapters only where the two
        # mates overlap, which misses inserts shorter than about 30 bp; those reads are then almost
        # all adapter, are classified as vector sequence by Centrifuge and do not align.
        shell:
            """
            mkdir -p {results_dir}/{wildcards.sample}/fastp
            fastp -i {input.r1} -I {input.r2} -o {output.r1} -O {output.r2} -h {output.html} -j {output.json} -w {threads} --detect_adapter_for_pe
            """

    rule fastqc_pe:
        input:
            r1=f"{results_dir}/{{sample}}/{{sample}}_clean_R1.fastq.gz",
            r2=f"{results_dir}/{{sample}}/{{sample}}_clean_R2.fastq.gz"
        output:
            r1_html=f"{results_dir}/{{sample}}/fastqc/{{sample}}_clean_R1_fastqc.html",
            r1_zip=f"{results_dir}/{{sample}}/fastqc/{{sample}}_clean_R1_fastqc.zip",
            r2_html=f"{results_dir}/{{sample}}/fastqc/{{sample}}_clean_R2_fastqc.html",
            r2_zip=f"{results_dir}/{{sample}}/fastqc/{{sample}}_clean_R2_fastqc.zip"
        shell:
            r"""
            mkdir -p {results_dir}/{wildcards.sample}/fastqc
            fastqc {input.r1} -o {results_dir}/{wildcards.sample}/fastqc
            fastqc {input.r2} -o {results_dir}/{wildcards.sample}/fastqc
            """

    rule centrifuge_pe:
        input:
            r1 = f"{results_dir}/{{sample}}/{{sample}}_clean_R1.fastq.gz",
            r2 = f"{results_dir}/{{sample}}/{{sample}}_clean_R2.fastq.gz"
        output:
            classifications = temp(f"{results_dir}/{{sample}}/centrifuge/initial.tsv"),
            report = f"{results_dir}/{{sample}}/centrifuge/{{sample}}_report.txt"
        params:
            db = centrifuge_index_path,
            # see centrifuge_se: the other intermediates live in tmp/ and are removed by the rule itself
            tmp = f"{results_dir}/{{sample}}/centrifuge/tmp",
        threads: 12
        benchmark: f"benchmarks/{{sample}}_centrifuge_benchmark.txt"
        shell:
            r"""
            rm -rf {params.tmp} && mkdir -p {params.tmp}
            centrifuge -x {params.db} -1 {input.r1} -2 {input.r2} -S {output.classifications} -p {threads} --report-file {results_dir}/{wildcards.sample}/centrifuge/{wildcards.sample}_prefilter_abundance.tsv >/dev/null 2>&1
            awk 'NR>1 && $3!=0 && $8==1 {{print $1}}' {output.classifications} | sort -u > {params.tmp}/good_reads.txt
            gzip -cd {input.r1} | awk 'BEGIN {{ while ((getline < "{params.tmp}/good_reads.txt")>0) keep[$1]=1 }} NR%4==1 {{ rid=substr($1,2); keep_read=(rid in keep) }} keep_read {{print}}' > {params.tmp}/clean_R1_unambiguous.fastq
            gzip -cd {input.r2} | awk 'BEGIN {{ while ((getline < "{params.tmp}/good_reads.txt")>0) keep[$1]=1 }} NR%4==1 {{ rid=substr($1,2); keep_read=(rid in keep) }} keep_read {{print}}' > {params.tmp}/clean_R2_unambiguous.fastq
            centrifuge -x {params.db} -1 {params.tmp}/clean_R1_unambiguous.fastq -2 {params.tmp}/clean_R2_unambiguous.fastq -S {params.tmp}/output.tsv -p {threads} --report-file {results_dir}/{wildcards.sample}/centrifuge/{wildcards.sample}_abundance.tsv >/dev/null 2>&1
            centrifuge-kreport -x {params.db} {params.tmp}/output.tsv > {output.report}
            rm -rf {params.tmp}
            """
            
    rule vg_giraffe_pe:
        input:
            r1=lambda wc: f"{results_dir}/{wc.sample}/{wc.sample}_clean_R1.fastq.gz",
            r2=lambda wc: f"{results_dir}/{wc.sample}/{wc.sample}_clean_R2.fastq.gz",
            passed_qc=lambda wc: f"checkpoints/passed/{wc.sample}.pass"
        output:
            # several GB per sample and only read by vg surject and vg stats: removed once both ran
            gam=temp(f"{results_dir}/{{sample}}/vg/{{sample}}.gam")
        params:
            graph=vg_index+".d2.gbz",
            dist=vg_index+".d2.dist",
            min=lambda wc: get_minimizer_for_sample(wc.sample)
        threads: 12
        benchmark: f"benchmarks/{{sample}}_giraffe_benchmark.txt"
        shell:
            """
            mkdir -p {results_dir}/{wildcards.sample}/vg
            vg giraffe -Z {params.graph} -f {input.r1} -f {input.r2} -d {params.dist} -m {params.min} -t {threads} -o GAM > {output.gam}
            """
    
    rule vg_surject_pe:
        input:
            gam=f"{results_dir}/{{sample}}/vg/{{sample}}.gam",
            passed_qc=lambda wc: f"checkpoints/passed/{wc.sample}.pass"
        output:
            bam=temp(f"{results_dir}/{{sample}}/vg/{{sample}}.bam")
        params:
            graph=vg_index + ".d2.gbz",
            gref=gref,
            strip_prefix="#".join(gref.split("#")[:-1]) + "#"
        threads: 12
        benchmark: f"benchmarks/{{sample}}_surject_benchmark.txt"
        shell:
            """
            vg surject -x {params.graph} -b -i -p {params.gref} -t {threads} {input.gam} | \
            samtools view -h - | \
            sed 's/{params.strip_prefix}//g' | \
            samtools view -b - > {output.bam}
            """

####Not PE/SE specific rules
#Getting statistics for vg alignment
rule vg_stats:
    input:
        gam=f"{results_dir}/{{sample}}/vg/{{sample}}.gam"
    output:
        txt=f"{results_dir}/{{sample}}/vg/{{sample}}_giraffe.stats.txt"
    #Add time information at end to meet multiqc requirements
    shell:
        """
        vg stats -a {input.gam} > {output.txt}
        echo "Total time: 123 seconds" >> {output.txt}
        echo "Speed: 123 reads/second" >> {output.txt}
        """

#RSeQC: read orientation relative to the annotation (decides strandedness, below) and gene body coverage
rule rseqc:
    input:
        bam = f"{results_dir}/{{sample}}/vg/{{sample}}.bam"
    output:
        infer_experiment = f"{results_dir}/{{sample}}/rseqc/{{sample}}_infer_experiment.txt",
        genebody_cov_txt = f"{results_dir}/{{sample}}/rseqc/{{sample}}_genebody_cov.geneBodyCoverage.txt",
        genebody_cov_r = f"{results_dir}/{{sample}}/rseqc/{{sample}}_genebody_cov.geneBodyCoverage.r",
        sorted_bam = alignment(f"{results_dir}/{{sample}}/vg/{{sample}}_sort.bam"),
        bam_index = alignment(f"{results_dir}/{{sample}}/vg/{{sample}}_sort.bam.bai")
    params:
        annotation_bed = annotation_bed
    threads: 8   # used by samtools sort only; the RSeQC scripts run on one core
    benchmark: f"benchmarks/{{sample}}_rseqc_benchmark.txt"
    shell:
        r"""
        mkdir -p {results_dir}/{wildcards.sample}/rseqc
        infer_experiment.py -i {input.bam} -r {params.annotation_bed} > {output.infer_experiment}
        samtools sort -@ {threads} -o {output.sorted_bam} {input.bam}
        samtools index {output.sorted_bam}
        awk -F"\t" '$4 ~ /^CDS:/' {params.annotation_bed} > {results_dir}/{wildcards.sample}/rseqc/genes.bed
        # run inside the rseqc directory: geneBody_coverage.py writes a log.txt into the cwd
        (cd {results_dir}/{wildcards.sample}/rseqc && geneBody_coverage.py -r genes.bed -i ../vg/{wildcards.sample}_sort.bam -o {wildcards.sample}_genebody_cov)
        """


#Strandedness of one sample
rule strand_call:
    input:
        infer_experiment = f"{results_dir}/{{sample}}/rseqc/{{sample}}_infer_experiment.txt"
    output:
        f"{results_dir}/{{sample}}/rseqc/{{sample}}_strandedness.tsv"
    shell:
        """
        python {scripts_dir}/call_strandedness.py call --infer {input.infer_experiment} --sample {wildcards.sample} \
            --mode {strandedness_mode} --min-fraction {strandedness_min_fraction} --out {output}
        """

def _qc_passed_strand_calls(wildcards):
    checkpoints.qc_passed_samples.get()
    return [f"{results_dir}/{s}/rseqc/{s}_strandedness.tsv" for s in get_passed_samples_from_checkpoint(wildcards)]

def _qc_passed_species(wildcards):
    checkpoints.qc_passed_samples.get()
    if not species_gate:
        return []
    return [f"{results_dir}/{s}/qc/{s}_species.json" for s in get_passed_samples_from_checkpoint(wildcards)]

###Gate after alignment: unstranded libraries and samples that are not E. coli are not counted
checkpoint strand_passed_samples:
    input:
        strand=_qc_passed_strand_calls,
        species=_qc_passed_species
    output:
        table=STRAND_TABLE,
        mqc=f"{results_dir}/strandedness_mqc.tsv",
        failures="checkpoints/strandedness_failures.json"
    run:
        excluded = {}
        for path in input.species:
            with open(path) as fh:
                verdict = json.load(fh).get("verdict")
            if verdict not in ("ok", "no_species"):
                excluded[os.path.basename(path)[:-len("_species.json")]] = verdict
        rows = call_strandedness.combine(list(input.strand), output.table, output.mqc, output.failures, excluded)
        for r in rows:
            if r["counted"] != "yes":
                print(f"NOT COUNTED: {r['sample']}: {r['not_counted_reason']} (forward {r['fraction_forward']}, "
                      f"reverse {r['fraction_reverse']})", file=sys.stderr, flush=True)


####Rules that require all samples in an experiment
# One feature per row of the counting annotation (`-t gene -g ID`). A read is counted for every
# feature it overlaps on its own strand (-O); paired-end runs count fragments (--countReadPairs).
# -s is given per BAM, so forward- and reverse-stranded samples can share a run.
FEATURECOUNTS_OPTIONS = "-t gene -g ID -O" + ("" if SE else " -p --countReadPairs")

rule featurecounts_combined:
    input:
        bams=lambda wc: expand(
            f"{results_dir}/{{sample}}/vg/{{sample}}_sort.bam",
            sample=get_counted_samples(wc)
        ),
        strand=STRAND_TABLE,
        annotation=annotation_gff
    output:
        counts=f"{results_dir}/all_samples_raw_counts.txt",
        summary=f"{results_dir}/all_samples_raw_counts.txt.summary",
        antisense=f"{results_dir}/all_samples_antisense_counts.txt",
        antisense_summary=f"{results_dir}/all_samples_antisense_counts.txt.summary",
        method=f"{results_dir}/counting_method.json"
    params:
        options=FEATURECOUNTS_OPTIONS,
        strand_flags=lambda wc, input: call_strandedness.featurecounts_strand_flags(input.strand, get_counted_samples(wc)),
        # the same counting with every sample's strand reversed: reads antisense to each feature
        antisense_flags=lambda wc, input: call_strandedness.featurecounts_strand_flags(
            input.strand, get_counted_samples(wc)).translate(str.maketrans("12", "21"))
    threads: 8
    benchmark: f"benchmarks/featurecounts_benchmark.txt"
    run:
        os.makedirs(os.path.dirname(output.counts), exist_ok=True)
        # `featurecounts_tmp_local: true` puts featureCounts' temporary files in this node's
        # temporary directory instead of the results directory. For paired-end BAMs it writes the
        # reads out again in hundreds of files (about 100 GB for a 9 GB BAM) and merges them; on a
        # network file system that merge can take most of a day per BAM. A directory can be given
        # instead of `true`.
        import shutil, tempfile
        where = config.get("featurecounts_tmp_local")
        if where is True or str(where).lower() == "true":
            where = resources.tmpdir
        if where:
            os.makedirs(where, exist_ok=True)
        tmp = tempfile.mkdtemp(prefix="featurecounts_", dir=where) if where else None
        tmp_opt = f"--tmpDir {tmp}" if tmp else ""
        try:
            shell("featureCounts -T {threads} {tmp_opt} -a {input.annotation} -o {output.counts} {params.options} -s {params.strand_flags} {input.bams}")
            shell("featureCounts -T {threads} {tmp_opt} -a {input.annotation} -o {output.antisense} {params.options} -s {params.antisense_flags} {input.bams}")
        finally:
            if tmp:
                shutil.rmtree(tmp, ignore_errors=True)
        with open(input.annotation) as fh:
            annotation_header = [line[2:].rstrip("\n") for line in fh if line.startswith("#!")]
        calls = {r["sample"]: r["call"] for r in call_strandedness.read_table(input.strand)}
        with open(output.method, "w") as fh:
            json.dump({
                "annotation": os.path.basename(input.annotation),
                "annotation_header": annotation_header,
                "featurecounts_options": f"{params.options} -s {params.strand_flags}",
                "layout": "single-end" if SE else "paired-end",
                "counting_unit": "reads" if SE else "fragments",
                "overlap_rule": "a read is counted for every feature it overlaps on its own strand",
                "multi_mapping": "each read has one alignment; reads with equally good placements are "
                                 "placed on one of them by the aligner and counted there",
                "strandedness": calls,
                "not_counted": sorted(s for s, c in calls.items() if c == "unstranded"),
            }, fh, indent=2)

####Per-sample QC record (docs/atlas_qc_inputs.md)
# Alignments are not kept for the atlas, so what needs them is taken here: coverage track,
# fragment sizes, species statistics. `<sample>.qc.json` then gathers everything about a sample.
def _package_commit():
    import subprocess
    try:
        return subprocess.run(["git", "-C", workflow.basedir, "rev-parse", "--short", "HEAD"], capture_output=True,
                              text=True, check=True).stdout.strip()
    except Exception:
        return ""

def _package_version():
    try:
        from importlib.metadata import version
        return version("ecoli_ingest")
    except Exception:
        return ""

def _sample_runs(sample):
    """The sample's runs, for accession samples: [{"run": ..., "spots": ...}]."""
    spots = READS[sample].get("spots") or {}
    return json.dumps([{"run": run, "spots": n} for run, n in spots.items()], separators=(",", ":"))

run_metadata = config.get("run_metadata") or ""    # optional table with a run_accession column (e.g. the atlas manifest's runs.tsv)

rule tool_versions:
    output:
        f"{results_dir}/tool_versions.json"
    params:
        commit=_package_commit(),
        version=_package_version(),
        annotation=os.path.basename(annotation_gff)
    shell:
        """
        python {scripts_dir}/sample_qc.py versions --commit "{params.commit}" --package-version "{params.version}" --annotation {params.annotation:q} --out {output}
        """

rule bam_qc:
    input:
        bam = f"{results_dir}/{{sample}}/vg/{{sample}}_sort.bam",
        strand = f"{results_dir}/{{sample}}/rseqc/{{sample}}_strandedness.tsv"
    output:
        coverage = f"{results_dir}/{{sample}}/coverage/{{sample}}.cov100.npz",
        qc = f"{results_dir}/{{sample}}/qc/{{sample}}_bam_qc.json"
    benchmark: f"benchmarks/{{sample}}_bam_qc_benchmark.txt"
    shell:
        """
        python {scripts_dir}/sample_qc.py bam --bam {input.bam} --strand {input.strand} --sample {wildcards.sample:q} \
            --bed {annotation_bed} --coverage {output.coverage} --out {output.qc}
        """

# Is the library E. coli? Both rules use the classification of every trimmed read (Centrifuge's
# first pass). species_early runs before alignment and only flags samples that are clearly
# something else; species_qc runs after it, leaves out the reads on rRNA / tRNA genes and gives the
# verdict that decides whether the sample is counted (checkpoint strand_passed_samples).
rule species_early:
    input:
        classifications = f"{results_dir}/{{sample}}/centrifuge/initial.tsv"
    output:
        report_all = f"{results_dir}/{{sample}}/centrifuge/{{sample}}_report_all.txt",
        species = f"{results_dir}/{{sample}}/qc/{{sample}}_species_early.json"
    params:
        db = centrifuge_index_path,
        thresholds = species_thresholds
    benchmark: f"benchmarks/{{sample}}_species_early_benchmark.txt"
    shell:
        """
        python {scripts_dir}/species_metrics.py --classifications {input.classifications} --index {params.db} \
            --report-all {output.report_all} --thresholds {params.thresholds:q} --out {output.species}
        """

rule species_qc:
    input:
        classifications = f"{results_dir}/{{sample}}/centrifuge/initial.tsv",
        report_all = f"{results_dir}/{{sample}}/centrifuge/{{sample}}_report_all.txt",
        bam = f"{results_dir}/{{sample}}/vg/{{sample}}_sort.bam"
    output:
        species = f"{results_dir}/{{sample}}/qc/{{sample}}_species.json"
    params:
        thresholds = species_thresholds
    benchmark: f"benchmarks/{{sample}}_species_benchmark.txt"
    shell:
        """
        python {scripts_dir}/species_metrics.py --classifications {input.classifications} \
            --report-all {input.report_all} --bam {input.bam} --bed {annotation_bed} \
            --thresholds {params.thresholds:q} --out {output.species}
        """

rule sample_qc:
    input:
        fastp = f"{results_dir}/{{sample}}/fastp/{{sample}}_fastp.json",
        fastqc = lambda wc: [f"{results_dir}/{wc.sample}/fastqc/{wc.sample}_clean_R{m}_fastqc.zip"
                             for m in ((1,) if SE else (1, 2))],
        vg_stats = f"{results_dir}/{{sample}}/vg/{{sample}}_giraffe.stats.txt",
        gene_body = f"{results_dir}/{{sample}}/rseqc/{{sample}}_genebody_cov.geneBodyCoverage.txt",
        strand = STRAND_TABLE,
        counts = f"{results_dir}/all_samples_raw_counts.txt",
        antisense = f"{results_dir}/all_samples_antisense_counts.txt",
        bam_qc = f"{results_dir}/{{sample}}/qc/{{sample}}_bam_qc.json",
        coverage = f"{results_dir}/{{sample}}/coverage/{{sample}}.cov100.npz",
        species = lambda wc: [f"{results_dir}/{wc.sample}/qc/{wc.sample}_species.json"] if centrifuge_enabled else [],
        versions = f"{results_dir}/tool_versions.json",
        gff = annotation_gff
    output:
        f"{results_dir}/{{sample}}/qc/{{sample}}.qc.json"
    params:
        fastqc_r2 = lambda wc, input: f"--fastqc-r2 {input.fastqc[1]}" if len(input.fastqc) > 1 else "",
        species = lambda wc, input: f"--species {input.species[0]}" if input.species else "",
        runs = lambda wc: _sample_runs(wc.sample),
        run_metadata = f"--run-metadata {run_metadata}" if run_metadata else ""
    shell:
        """
        python {scripts_dir}/sample_qc.py collect --sample {wildcards.sample:q} --fastp {input.fastp} \
            --fastqc-r1 {input.fastqc[0]} {params.fastqc_r2} --vg-stats {input.vg_stats} --gene-body {input.gene_body} \
            --strand {input.strand} --counts {input.counts} --antisense {input.antisense} --gff {input.gff} \
            --bam-qc {input.bam_qc} --coverage {input.coverage} --bed {annotation_bed} {params.species} \
            --versions {input.versions} \
            --runs {params.runs:q} {params.run_metadata} --out {output}
        """

#Sample metadata for DESeq2        
rule generate_sample_metadata:
    input:
        strand=STRAND_TABLE
    output:
        temp(f"{results_dir}/sample_metadata.tsv")
    run:
        import pandas as pd

        samples = config["samples"]

        #Use only the samples that are counted (passed QC and strand-specific)
        passed_samples = call_strandedness.counted_samples(input.strand)

        metadata = []
        for sample_id in passed_samples:
            info = samples[sample_id]
            row = {"sample_id": sample_id}
            row["condition"] = info.get("condition", "NA")
            if "condition2" in info:
                row["condition2"] = info["condition2"]
            metadata.append(row)

        df = pd.DataFrame(metadata)
        df.to_csv(output[0], sep="\t", index=False)
        

#Running DEseq using comparison listed in config file
deseq_results_outputs = expand(f"{results_dir}/deseq2/{{contrast}}_deseq_results.tsv", contrast=contrast_names) #Need a list of outputs from contrasts
rule run_deseq2:
    input:
        counts=f"{results_dir}/all_samples_counts.tsv",
        metadata=f"{results_dir}/sample_metadata.tsv",
        extended=f"{results_dir}/all_samples_counts_extended.tsv"
    output:
        pca_coords=f"{results_dir}/deseq2/pca_coordinates.tsv",
        pca_plot=f"{results_dir}/deseq2/pca_plot.png",
        pca_mqc = f"{results_dir}/deseq2/pca_mqc.tsv",
        norm_counts=f"{results_dir}/deseq2/normalized_counts.tsv",
        results = deseq_results_outputs
    params:
        outdir=f"{results_dir}/deseq2",
        contrasts_json=json.dumps(deseq2_contrasts)
    benchmark: f"benchmarks/deseq_benchmark.txt"
    shell:
        """
        mkdir -p {params.outdir}

        Rscript {scripts_dir}/run_deseq2.R {input.counts} {input.metadata} {params.outdir} '{params.contrasts_json}'

        cat {scripts_dir}/pca_header.txt <(
            echo -e "id\\tPC1\\tPC2\\tcondition"
            # the header has no name for the row-name column, so data columns are shifted by one
            awk 'BEGIN{{FS=OFS="\\t"}} NR==1 {{c=NF+1; for (i=1; i<=NF; i++) if ($i=="condition") c=i+1; next}} {{print $1, $2, $3, $c}}' {output.pca_coords}
        ) > {output.pca_mqc}
        """
        
#Annotating the combined counts table with feature identifiers (symbol, locus tag, type, source,
