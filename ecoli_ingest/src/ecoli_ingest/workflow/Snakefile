rule summarize_deseq_results:
    input:
        deseq_result=f"{results_dir}/deseq2/{{wildcards.contrast}}_deseq_results.tsv",
        extended=f"{results_dir}/all_samples_counts_extended.tsv"
    output:
        summary_file=f"{results_dir}/deseq2/{{wildcards.contrast}}_deseq_results_summary.tsv"
    params:
        outdir=f"{results_dir}/deseq2"
    shell:
        """
        awk -v extended_input="{input.extended}" '
            BEGIN{{FS=OFS="\\t"}}
            NR==FNR && FILENAME == extended_input {{
                id[$1]=$2;
                summary[$1]=$3;
                next
            }}
            FNR==1 {{print $0, "Gene_IDs_Field", "Gene_Summary"; next}}
            FNR>1 {{print $0, id[$1], summary[$1]}}
        ' "{input.extended}" "{input.deseq_result}" > "{output.summary_file}"
        """

