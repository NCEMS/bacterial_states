# Apptainer image of Ecoli_inGEST: the environment of a major version, i.e. the workflow tools of locks/linux-64.txt
# (the exact environment of the atlas recount), plus the ecoli_ingest package as of the build. Build with
# release/build_container.sh, which stages the package tree and fills in VERSION / REVISION (the package copy) and
# ENVIRONMENT / LOCK_SHA256 (the environment); %files paths are relative to that staging directory.
#
#   ecoli_ingest run --container always                  # the host launcher: its own Snakefile, tools from the image
#   apptainer run ecoli_ingest_env<id>.sif check|run ... # the launcher copied into the image at its build
Bootstrap: docker
# mambaorg/micromamba:2.10.0-debian13-slim, pinned by digest (apptainer refuses a tag together with a digest)
From: mambaorg/micromamba@sha256:e1476182cd40eb1f7c0cfae4adec9bfd78f3d7f05c61368306abfdc8939c1198

%arguments
    VERSION=unset
    REVISION=unset
    ENVIRONMENT=unset
    LOCK_SHA256=unset

%files
    ecoli_ingest /opt/src/ecoli_ingest

%post
    set -eu
    export MAMBA_ROOT_PREFIX=/opt/conda
    # the explicit lock: no solve, every package by URL and MD5
    micromamba install --yes --name base --file /opt/src/ecoli_ingest/locks/linux-64.txt
    /opt/conda/bin/python -m pip install --no-deps --no-build-isolation --no-index --no-cache-dir /opt/src/ecoli_ingest
    micromamba clean --all --yes
    rm -rf /opt/conda/pkgs /root/.cache

%environment
    export MAMBA_ROOT_PREFIX=/opt/conda
    export CONDA_PREFIX=/opt/conda
    export PATH=/opt/conda/bin:$PATH
    # what `conda activate` would do (JAVA_HOME of openjdk for FastQC, R's variables)
    for f in /opt/conda/etc/conda/activate.d/*.sh; do
        case "$f" in */activate-*_linux-64.sh) continue ;; esac   # compiler wrappers (R's dependencies): unused, bash-only syntax
        [ -r "$f" ] && . "$f"
    done
    unset f

%labels
    org.opencontainers.image.title ecoli_ingest
    org.opencontainers.image.version {{ VERSION }}
    org.opencontainers.image.revision {{ REVISION }}
    org.ncems.environment {{ ENVIRONMENT }}
    org.ncems.lock-sha256 {{ LOCK_SHA256 }}
    org.opencontainers.image.source https://github.com/NCEMS/bacterial_states
    org.opencontainers.image.licenses MIT

%test
    set -eu
    test "$(sha256sum /opt/src/ecoli_ingest/locks/linux-64.txt | cut -d' ' -f1)" = "{{ LOCK_SHA256 }}"
    tmp=$(mktemp -d)
    python /opt/src/ecoli_ingest/src/ecoli_ingest/workflow/scripts/sample_qc.py versions --out "$tmp/versions.json"
    python /opt/src/ecoli_ingest/build/check_versions.py --env /opt/src/ecoli_ingest/environment.yaml \
        --versions "$tmp/versions.json"
    for exe in prefetch fasterq-dump pigz centrifuge-kreport geneBody_coverage.py Rscript; do
        command -v "$exe" >/dev/null || { echo "missing: $exe" >&2; exit 1; }
    done
    Rscript -e 'suppressPackageStartupMessages(library(DESeq2))'
    test "$(python -c 'import ecoli_ingest; print(ecoli_ingest.__version__)')" = "{{ VERSION }}"
    rm -rf "$tmp"

%runscript
    exec ecoli_ingest "$@"

%help
    Ecoli_inGEST environment {{ ENVIRONMENT }} (lock {{ LOCK_SHA256 }}); launcher copy {{ VERSION }} ({{ REVISION }}).
    `ecoli_ingest run --container always` on the host, or `apptainer run <image> --help`.
    Resource bundles are not in the image: `ecoli_ingest download`, then bind the resources directory.
