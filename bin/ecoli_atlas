#!/usr/bin/env bash
# Run the ecoli_atlas CLI straight from this checkout without installing it (the active Python
# still needs the dependencies: torch, numpy, pandas, scipy, scikit-learn, pyyaml).
# With ECOLI_ATLAS_IMAGE=<ecoli_atlas_env<id>.sif> the checkout's code runs inside that Apptainer image instead
# (the image supplies the environment; the checkout and the current directory are bound in; ECOLI_ATLAS_BIND adds
# more, comma-separated, e.g. the directory with the models and data).
repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
if [ -n "${ECOLI_ATLAS_IMAGE:-}" ]; then
  runtime=${ECOLI_ATLAS_APPTAINER:-$(command -v apptainer || command -v singularity || true)}
  [ -n "$runtime" ] || { echo "ECOLI_ATLAS_IMAGE is set, but no apptainer/singularity is on PATH" >&2; exit 1; }
  exec "$runtime" run --bind "$repo,$PWD${ECOLI_ATLAS_BIND:+,$ECOLI_ATLAS_BIND}" \
    --env "ECOLI_ATLAS_SRC=$repo/ecoli_atlas/src" "$ECOLI_ATLAS_IMAGE" "$@"
fi
PYTHONPATH="$repo/ecoli_atlas/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m ecoli_atlas.cli "$@"
